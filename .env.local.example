# =====================================================================
# SUPABASE
# =====================================================================
# Project Settings → Data API : copier "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Project Settings → API Keys :
#   Onglet "Publishable key" (ex-"anon" public) → eyJhbGc... ou sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

#   Onglet "Secret keys" (ex-"service_role") — créer une clé "default" si nécessaire.
#   ⚠️ NE JAMAIS exposer côté client. Utilisée uniquement par les routes API.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# =====================================================================
# STRIPE
# =====================================================================
# Dashboard Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Dashboard Stripe → Developers → Webhooks → Add endpoint (checkout.session.completed)
# En local : stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx

# =====================================================================
# APP
# =====================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
